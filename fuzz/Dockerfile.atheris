# Coverage-guided Python fuzzing container for G1-Docket (Google Atheris / libFuzzer)
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app

COPY schemas ./schemas
COPY registry ./registry
COPY engine ./engine
COPY fuzz ./fuzz

RUN pip install --no-cache-dir cryptography jsonschema pytest hypothesis atheris \
    && groupadd --system fuzzer \
    && useradd --system --gid fuzzer --home-dir /app --no-create-home fuzzer \
    && chown -R fuzzer:fuzzer /app

USER fuzzer

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD python -c "import atheris, hypothesis" || exit 1

CMD ["sh", "-c", "pytest -v fuzz/ && python fuzz/run_atheris.py --runs 2000"]
