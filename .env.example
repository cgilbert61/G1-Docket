# G1 Docket & Combine Governance, WORM Audit, and SIEM Subsystem Environment Config

# Enterprise Data Governance, Steward Routing & Production Mode
# Set DOCKET_DEMO_MODE=false in production to disable UI demo shortcuts and mock approvals
DOCKET_DEMO_MODE=true
DOCKET_COMPANY_DOMAIN=yourcompany.com
DOCKET_DEFAULT_ORG_UNIT="Enterprise Data & AI Governance"
DOCKET_DEFAULT_OWNER=data-operations@yourcompany.com
DOCKET_DEFAULT_STEWARD=data-governance@yourcompany.com

# Tier-Specific Data Steward Mailboxes
DOCKET_STEWARD_RESTRICTED=privacy-compliance@yourcompany.com
DOCKET_STEWARD_CONFIDENTIAL=infosec-stewards@yourcompany.com
DOCKET_STEWARD_INTERNAL=engineering-stewards@yourcompany.com
DOCKET_STEWARD_PUBLIC=open-data-stewards@yourcompany.com

# Production Crawl Target (Local directory, fileshare UNC, S3, ADLS, or lakehouse URI)
# DOCKET_CRAWL_DIRECTORY="D:\CorporateShares\KnowledgeBase"

# Governance Server Settings
GOVERNANCE_HOST=0.0.0.0
GOVERNANCE_PORT=18084
INFERENCE_GATEWAY_URL=http://localhost:18082

# WORM Ledger & Persistence Storage
WORM_SQLITE_PATH=data/governance/worm_ledger.db
WORM_JSONL_PATH=data/governance/worm_ledger.jsonl
QUARANTINE_DB_PATH=data/governance/quarantine.db
SIEM_BUFFER_DB_PATH=data/governance/siem_buffer.db
POD_KEY_DIR=.pod_keys

# Datadog Cloud Logs API
DD_API_KEY=your-datadog-api-key-here
DD_SITE=datadoghq.com

# Splunk Enterprise HTTP Event Collector (HEC)
SPLUNK_HEC_URL=https://splunk.corp.internal:8088/services/collector/event
SPLUNK_HEC_TOKEN=your-splunk-hec-token-here

# Elasticsearch / OpenSearch
ELASTIC_URL=https://elastic.corp.internal:9200/g1-security-events/_doc
ELASTIC_API_KEY=your-elastic-api-key-here

# Microsoft Sentinel / Azure Monitor
AZURE_LOG_ANALYTICS_WORKSPACE_ID=your-azure-workspace-id
AZURE_LOG_ANALYTICS_SHARED_KEY=your-azure-shared-key

# AWS CloudWatch Logs / Firehose
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
CLOUDWATCH_LOG_GROUP=/g1/docket/security

# RFC 5424 / CEF Syslog
SYSLOG_HOST=127.0.0.1
SYSLOG_PORT=514
SYSLOG_USE_TLS=false

# Google Cloud Logging (SIEM Export)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOG_NAME=projects/your-gcp-project-id/logs/g1-docket-security-events

# ==============================================================================
# Enterprise Cloud KMS & Hardware Security Module (HSM) Signing Keyring
# ==============================================================================
# Provider options: local, aws, azure, gcp, vault
DOCKET_KMS_PROVIDER=local

# AWS KMS / CloudHSM
# AWS_KMS_KEY_ARN=arn:aws:kms:us-east-1:123456789012:key/mrk-12345678abcdef

# Azure Key Vault / Managed HSM
# AZURE_KEY_VAULT_URL=https://corp-docket-vault.vault.azure.net
# AZURE_KMS_KEY_NAME=docket-attestation-key
# AZURE_KMS_KEY_VERSION=

# Google Cloud KMS / Cloud HSM
# GCP_KMS_KEY_NAME=projects/corp-prod/locations/us/keyRings/docket-ring/cryptoKeys/attest-signer/cryptoKeyVersions/1

# HashiCorp Vault Transit Secrets Engine
# VAULT_ADDR=https://vault.corp.internal:8200
# VAULT_TRANSIT_KEY_NAME=docket-attestation-key
# VAULT_TRANSIT_MOUNT=transit
# VAULT_TOKEN=

# ==============================================================================
# Enterprise IdP / Single Sign-On (SSO) & OIDC Bearer Token Verification
# ==============================================================================
# Require authentication in production
DOCKET_REQUIRE_AUTH=true
# OIDC Token Claims Matching
DOCKET_OIDC_ISSUER=https://sts.windows.net/your-tenant-id/
DOCKET_OIDC_AUDIENCE=api://g1-docket-governance

