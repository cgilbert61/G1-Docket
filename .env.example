# G1 Docket & Combine Governance, WORM Audit, and SIEM Subsystem Environment Config

# Governance Server Settings
GOVERNANCE_HOST=0.0.0.0
GOVERNANCE_PORT=18084
INFERENCE_GATEWAY_URL=http://localhost:18082

# WORM Ledger & Persistence Storage
WORM_SQLITE_PATH=data/governance/worm_ledger.db
WORM_JSONL_PATH=data/governance/worm_ledger.jsonl
QUARANTINE_DB_PATH=data/governance/quarantine.db
SIEM_BUFFER_DB_PATH=data/governance/siem_buffer.db
POD_KEY_DIR=.pod_keys

# Datadog Cloud Logs API
DD_API_KEY=your-datadog-api-key-here
DD_SITE=datadoghq.com

# Splunk Enterprise HTTP Event Collector (HEC)
SPLUNK_HEC_URL=https://splunk.corp.internal:8088/services/collector/event
SPLUNK_HEC_TOKEN=your-splunk-hec-token-here

# Elasticsearch / OpenSearch
ELASTIC_URL=https://elastic.corp.internal:9200/g1-security-events/_doc
ELASTIC_API_KEY=your-elastic-api-key-here

# Microsoft Sentinel / Azure Monitor
AZURE_LOG_ANALYTICS_WORKSPACE_ID=your-azure-workspace-id
AZURE_LOG_ANALYTICS_SHARED_KEY=your-azure-shared-key

# AWS CloudWatch Logs / Firehose
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
CLOUDWATCH_LOG_GROUP=/g1/docket/security

# RFC 5424 / CEF Syslog
SYSLOG_HOST=127.0.0.1
SYSLOG_PORT=514
SYSLOG_USE_TLS=false
