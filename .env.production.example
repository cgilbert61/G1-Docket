# ==============================================================================
# G1 DOCKET — ENTERPRISE PRODUCTION CONFIGURATION TEMPLATE (.env.production.example)
# Hardened configuration for Fortune 500 Kubernetes, Cloud KMS, and Corporate SIEM.
# Copy to .env in your production environment and populate via Vault / External Secrets.
# ==============================================================================

# Master Environment Switch
# When set to "production", UI demo fast-track shortcuts are disabled, Four-Eyes
# identity separation is strictly enforced, and live enterprise connectors are required.
DOCKET_ENVIRONMENT=production
DOCKET_DEMO_MODE=false

# Corporate Identity & Data Steward Ownership
DOCKET_COMPANY_DOMAIN=yourcompany.com
DOCKET_DEFAULT_ORG_UNIT="Enterprise Data & AI Governance"
DOCKET_DEFAULT_OWNER=data-operations@yourcompany.com
DOCKET_DEFAULT_STEWARD=data-governance@yourcompany.com

# Tier-Specific Data Steward Mailboxes
DOCKET_STEWARD_RESTRICTED=privacy-compliance@yourcompany.com
DOCKET_STEWARD_CONFIDENTIAL=infosec-stewards@yourcompany.com
DOCKET_STEWARD_INTERNAL=engineering-stewards@yourcompany.com
DOCKET_STEWARD_PUBLIC=open-data-stewards@yourcompany.com

# Production Crawl Target (Enterprise S3 bucket, ADLS Gen2, or fileshare)
DOCKET_CRAWL_DIRECTORY=s3://corp-knowledge-lakehouse/prod/

# High-Availability Database & Attestation Store
# Uses PostgreSQL with TLS verification and managed connection pooling
POD_REGISTRY_DB_URL=postgresql+psycopg2://docket_app:CHANGE_ME_PASSWORD@db-postgres.internal.corp:5432/docket_registry?sslmode=verify-full&sslrootcert=/etc/ssl/certs/corporate-ca.pem

# Cryptographic Key Management (HSM / Cloud KMS)
# Keys are mounted into containers from Kubernetes Secrets or Vault CSI driver
POD_KEY_DIR=/var/run/secrets/g1.io/keys
POD_PUBLIC_KEY_DIR=/var/run/secrets/g1.io/keys/public
POD_PRIVATE_KEY_DIR=/var/run/secrets/g1.io/keys/private

# Production AI Gateway & Model Upstream
# Points to your authoritative LiteLLM / Azure OpenAI / Bedrock Gateway cluster
POD_PREVALIDATOR_MODE=enforce
POD_UPSTREAM_GATEWAY_URL=https://gateway.ai.internal.corp:443
POD_UPSTREAM_API_KEY=CHANGE_ME_IN_PRODUCTION_ENTERPRISE_API_KEY
POD_ENABLE_ABAC_DATA_RESIDENCY=true
POD_ENABLE_ABAC_DEPARTMENTAL_ISOLATION=true

# Immutable WORM Ledger & Long-Term Retention Storage
WORM_SQLITE_PATH=/var/lib/docket/persistence/worm_ledger.db
WORM_JSONL_PATH=/var/lib/docket/persistence/worm_ledger.jsonl
QUARANTINE_DB_PATH=/var/lib/docket/persistence/quarantine.db
SIEM_BUFFER_DB_PATH=/var/lib/docket/persistence/siem_buffer.db

# Administrative API Hardening
POD_ADMIN_API_KEY=CHANGE_ME_SECURE_ADMIN_API_KEY_AT_LEAST_32_CHARS
POD_CONTROL_PLANE_TOKEN=CHANGE_ME_SECURE_CONTROL_PLANE_TOKEN

# ------------------------------------------------------------------------------
# Enterprise SIEM Forwarding Destinations (Configure one or more corporate sinks)
# ------------------------------------------------------------------------------

# 1. Splunk Enterprise HTTP Event Collector (HEC)
SPLUNK_HEC_URL=https://splunk-hec.corp.internal:8088/services/collector/event
SPLUNK_HEC_TOKEN=CHANGE_ME_SPLUNK_HEC_TOKEN

# 2. Datadog Cloud Logs API
DD_API_KEY=CHANGE_ME_DATADOG_API_KEY
DD_SITE=datadoghq.com

# 3. Elasticsearch / OpenSearch ECS
ELASTIC_URL=https://elastic.corp.internal:9200/g1-security-events/_doc
ELASTIC_API_KEY=CHANGE_ME_ELASTIC_API_KEY

# 4. Microsoft Sentinel / Azure Log Analytics
AZURE_LOG_ANALYTICS_WORKSPACE_ID=CHANGE_ME_AZURE_WORKSPACE_ID
AZURE_LOG_ANALYTICS_SHARED_KEY=CHANGE_ME_AZURE_SHARED_KEY

# 5. AWS CloudWatch Logs
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=CHANGE_ME_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=CHANGE_ME_AWS_SECRET_KEY
CLOUDWATCH_LOG_GROUP=/g1/docket/security/audit

# 6. Corporate Syslog (CEF over TLS)
SYSLOG_HOST=syslog-gateway.corp.internal
SYSLOG_PORT=6514
SYSLOG_USE_TLS=true
