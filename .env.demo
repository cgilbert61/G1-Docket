# ==============================================================================
# G1 DOCKET — DEMO MODE CONFIGURATION (.env.demo)
# Optimized for zero-dependency local evaluation, automated tests, and interactive demos.
# ==============================================================================

# Master Environment Switch
DOCKET_ENVIRONMENT=demo
DOCKET_DEMO_MODE=true

# Organization Metadata
DOCKET_COMPANY_DOMAIN=demo.internal
DOCKET_DEFAULT_ORG_UNIT="AI Governance Lab"
DOCKET_DEFAULT_OWNER=demo-owner@demo.internal
DOCKET_DEFAULT_STEWARD=demo-steward@demo.internal

# Tier-Specific Data Steward Routing
DOCKET_STEWARD_RESTRICTED=restricted-steward@demo.internal
DOCKET_STEWARD_CONFIDENTIAL=confidential-steward@demo.internal
DOCKET_STEWARD_INTERNAL=internal-steward@demo.internal
DOCKET_STEWARD_PUBLIC=public-steward@demo.internal

# Local Synthetic Data Estate Target
DOCKET_CRAWL_DIRECTORY=pc_demo_folder

# Core Service Endpoints
GOVERNANCE_HOST=0.0.0.0
GOVERNANCE_PORT=18084
INFERENCE_GATEWAY_URL=http://localhost:18082
POD_ENGINE_SERVICE_URL=http://localhost:18083

# Local File-Based Storage & Ephemeral Keys
WORM_SQLITE_PATH=data/governance/worm_ledger.db
WORM_JSONL_PATH=data/governance/worm_ledger.jsonl
QUARANTINE_DB_PATH=data/governance/quarantine.db
SIEM_BUFFER_DB_PATH=data/governance/siem_buffer.db
POD_KEY_DIR=.pod_keys

# Prevalidator & Mock Upstream Gateway
POD_PREVALIDATOR_MODE=enforce
POD_UPSTREAM_GATEWAY_URL=http://localhost:14000
POD_ENABLE_ABAC_DATA_RESIDENCY=true
POD_ENABLE_ABAC_DEPARTMENTAL_ISOLATION=true

# Demo Loopback SIEM / Telemetry Receivers (Run via MockReceiverCluster)
SYSLOG_HOST=127.0.0.1
SYSLOG_PORT=15514
SYSLOG_USE_TLS=false
